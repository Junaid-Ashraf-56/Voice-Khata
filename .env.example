# Copy to .env and edit. All values are optional; these are the defaults.

# Ollama server and model tag. Check the exact tag with `ollama list`.
OLLAMA_URL=http://localhost:11434
MODEL_NAME=gemma4:e4b

# Stage 1 backend: "gemma" (audio input to the Gemma model) or "whisper" (faster-whisper)
TRANSCRIBE_BACKEND=gemma
# Only used when TRANSCRIBE_BACKEND=whisper. Any faster-whisper compatible model id or path.
WHISPER_MODEL=small

# SQLite file (created on first run)
DB_PATH=data/khata.db

# ffmpeg executable
FFMPEG_BIN=ffmpeg

# Seconds to wait for the model
MODEL_TIMEOUT=120
